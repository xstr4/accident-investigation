/* pages/index/index.wxss */
/* 保险查勘助手样式 */

/* ===== 页面容器 ===== */
.container {
  padding: 30rpx;
  background-color: #f5f7fa;
  min-height: 100vh;  /* 最小高度为屏幕高度，确保背景铺满 */
  box-sizing: border-box;
}

/* ===== 标题区 ===== */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;  /* text组件默认是inline，block才能独占一行 */
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

/* ===== 图片选择区 ===== */
.camera-section {
  width: 100%;
  height: 600rpx;
  margin: 20rpx auto;
  background: #fff;
  border-radius: 24rpx;
  display: flex;           /* 弹性布局，让内容居中 */
  align-items: center;      /* 垂直居中 */
  justify-content: center;  /* 水平居中 */
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;         /* 防止图片超出圆角 */
}

/* 占位提示样式 */
.camera-placeholder {
  text-align: center;
  color: #999;
}

.camera-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.placeholder-text {
  font-size: 30rpx;
  color: #aaa;
}

/* 预览图片样式 */
.preview-img {
  width: 100%;
  height: 100%;
  object-fit: contain;  /* 保持比例缩放，不裁剪 */
}

/* ===== 结果展示区 ===== */
.result-section {
  margin-top: 30rpx;
}

/* 结果卡片基础样式 */
.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;  /* 动画过渡效果 */
}

/* 警告样式（红色主题） */
.result-card.warning {
  border-left: 12rpx solid #ff4757;
  background: linear-gradient(135deg, #fff5f5 0%, #ffffff 100%);
}

/* 正常样式（绿色主题） */
.result-card.normal {
  border-left: 12rpx solid #2ed573;
  background: linear-gradient(135deg, #f5fff5 0%, #ffffff 100%);
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

/* 警告时文字红色 */
.warning .result-title {
  color: #ff4757;
}

/* 正常时文字绿色 */
.normal .result-title {
  color: #2ed573;
}

.result-confidence {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-top: 10rpx;
}

.boxes-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 26rpx;
  color: #888;
}

/* ===== 按钮区 ===== */
.action-buttons {
  margin-top: 50rpx;
}

/* 主按钮：蓝色 */
.btn-primary {
  background: linear-gradient(135deg, #4dabf7 0%, #339af0 100%);
  color: #fff;
  border-radius: 50rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(77, 171, 247, 0.3);
}

/* 按钮点击效果 */
.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 次要按钮：白色边框 */
.btn-secondary {
  background: #fff;
  color: #4dabf7;
  border: 2rpx solid #4dabf7;
  border-radius: 50rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* ===== 底部说明 ===== */
.footer {
  text-align: center;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.footer text {
  font-size: 24rpx;
  color: #bbb;
}
.image-container {
  position: relative;
  width: 100%;
}
.preview-img {
  width: 100%;
}
.detection-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}